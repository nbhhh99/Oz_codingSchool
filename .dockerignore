# Docker 는 .dockerignore 를 "빌드 컨텍스트 루트"에서만 읽는다.
# `docker build -f app/Dockerfile .` 처럼 컨텍스트가 repo 루트이면
# app/.dockerignore 는 적용되지 않으므로, 실제로 동작하는 파일은 이 파일이다.
# (app/.dockerignore 는 과제 요구사항 유지를 위해 동일 내용으로 함께 관리)

# 환경변수 / 시크릿
.env
.env.example

# 파이썬 캐시
**/__pycache__/
*.pyc
*.pyo

# 라이브러리 / 툴 캐시
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/

# 로컬 가상환경 / 버전 관리 메타
.venv/
.git/
.gitignore
.python-version

# 도커 관련 설정
docker-compose.yml
.dockerignore
app/.dockerignore

# 문서 (루트 한정)
docs/
README.md

# IDE / OS
.vscode/
.idea/
.DS_Store

# 로컬 런타임 업로드물 (컨테이너 기동 시 재생성됨)
media/
